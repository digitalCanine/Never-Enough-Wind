          "note": "a player quoted 6 to 7 steggs in chat on 2026-10-06, not a chart price"
        },
        {
          "item": "minecraft:golden_helmet",
          "name": "Summer Helmet",
          "lore": "- Godlike Regeneration",
          "event": true
        },
        {
          "item": "minecraft:cooked_beef",
          "name": "Medium Rare Beef",
          "lore": "Leftover food from the Minewind inn.",
          "event": true
        },
        {
          "item": "minecraft:beetroot",
          "name": "Player Heart",
          "lore": "Eat their heart to gain their courage."
        }
