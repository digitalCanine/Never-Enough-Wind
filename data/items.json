{
  "schema_version": 1,
  "notes": [
    "match on id, custom name and lore, not translated names",
    "1.20.4 nbt is in minecraft:custom_data on 1.21",
    "enchant lines are fake lore",
    "#0D0307/#000005 lore marker means nothing reliable",
    "group: currency, rarity or ?"
  ],
  "kinds": {
    "essence_book": {
      "item": "minecraft:knowledge_book",
      "name_regex": "^Essence of (?<essence>.+)$",
      "lore_kind_regex": "the essence of an? (?<kind>\\w+)\\.",
      "level": "4th lore line, name + roman level",
      "status": "confirmed",
      "note": "read the lore, books can be renamed"
    },
    "spellbook": {
      "item": "minecraft:book",
      "lore_regex": "^- Consumes (?<count>\\d+) (?<soul>\\w+) souls?\\.?$",
      "lore_flags": [
        "i"
      ],
      "fallback_name_regex": "Spellbook$",
      "status": "confirmed",
      "note": "not all have soul lines or end in Spellbook"
    },
    "infinity_block": {
      "lore_first_line_regex": "^An infinite source of (?<block>.+)$",
      "name_regex": "^Infinity (?<block>.+)$",
      "price": "look up the item id in prices.json blocks. slabs, stairs and walls use block_notes",
      "status": "confirmed on 5 blocks"
    },
    "midas_key": {
      "item": "minecraft:tripwire_hook",
      "lore_regex": "^Opens midas chest",
      "name_regex": "^(?:(?<key>.+?) )?(?:Midas Key|Key of Midas)$",
      "status": "confirmed",
      "note": "only midas keys dumped so far"
    },
    "gear_essences": {
      "header_line": "Essence",
      "essence_line_regex": "^(?<essence>[A-Za-z' -]+?)( (?<level>[IVX]+))?$",
      "trigger_line_regex": "^  --> (?<triggers>.+)$",
      "effect_line_regex": "^  <-- (?<effects>.+)$",
      "status": "confirmed on jester gear",
      "note": "'-' ends the list. normalize names, hyphens differ"
    },
    "soul_lines": {
      "accumulates_regex": "^- Accumulates (?<count>\\d+) (?<soul>\\w+) Souls?\\.?$",
      "consumes_regex": "^- Consumes (?<count>\\d+) (?<soul>\\w+) Souls?\\.?$",
      "lore_flags": [
        "i"
      ]
    },
    "soulbound": {
      "lore_regex": "^Soulbound: (?<name>\\S+)",
      "note": "plain text name, not uuid. aura stone colors are the § bits after it"
    },
    "cosmetic_hat": {
      "lore_contains": "Drag and drop on your head",
      "note": "rank line before, month after"
    },
    "aura_cookie": {
      "item": "minecraft:cookie",
      "lore_regex": "grants the (?<aura>.+) aura when eaten",
      "lore_flags": [
        "i"
      ]
    },
    "dated": {
      "last_lore_line_regex": "^(January|February|March|April|May|June|July|August|September|October|November|December) \\d{4}$",
      "note": "release month"
    }
  },
