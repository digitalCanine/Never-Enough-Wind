    },
    "mechanics": {
      "items": [
        {
          "item": "minecraft:compass",
          "name": "Game Menu (Right Click)",
          "lore": "Right-click to open the Game Menu!"
        },
        {
          "item": "minecraft:clock",
          "name": "Land Claim Clock",
          "lore": "Also shows the closest claim border"
        },
        {
          "item": "minecraft:ender_eye",
          "name": "Aura Stone",
          "lore": "Soulbound: "
        },
        {
          "item": "minecraft:stick",
          "name": "Trade Stick",
          "lore": "Trade I"
        }
      ]
    }
  },
  "gear": {
    "essences": {
      "header_line": "Essence",
      "essence_line_regex": "^(?<essence>[A-Za-z'& -]+?)( (?<level>[IVX]+))?$",
      "trigger_line_regex": "^  --> (?<triggers>.+)$",
      "effect_line_regex": "^  <-- (?<effects>.+)$",
      "note": "'-' ends the list. normalize names, hyphens differ"
    },
    "souls": {
      "accumulates_regex": "^- Accumulates (?<count>\\d+) (?<soul>\\w+) Souls?\\.?$",
      "consumes_regex": "^- Consumes (?<count>\\d+) (?<soul>\\w+) Souls?\\.?$",
      "lore_flags": [
        "i"
      ]
    },
    "soulbound": {
      "lore_regex": "^Soulbound: (?<name>\\S+)",
      "note": "plain text name, not uuid. aura stone colors are the § bits after it"
    }
  },
  "unknown_yet": [
    "communist potato and other castle stuff"
  ]
}
