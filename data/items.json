{
  "schema_version": 1,
  "notes": [
    "match on id, custom name and lore, not translated names",
    "1.20.4 nbt is in minecraft:custom_data on 1.21",
    "enchant lines are fake lore",
    "no lore: check the enchant and a colored non italic name, anvil renames have neither"
  ],
  "types": {
    "essence": {
      "match": {
        "item": "minecraft:knowledge_book",
        "name_regex": "^Essence of (?<essence>.+)$",
        "lore_kind_regex": "the essence of an? (?<kind>\\w+)\\.",
        "level": "4th lore line, name + roman level",
        "note": "read the lore, books can be renamed"
      }
    },
    "magic": {
      "match": {
        "item": "minecraft:book",
        "lore_regex": "^- Consumes (?<count>\\d+) (?<soul>\\w+) souls?\\.?$",
        "lore_flags": [
          "i"
        ],
        "fallback_name_regex": "Spellbook$",
        "note": "not all have soul lines or end in Spellbook"
      }
    },
    "infinite": {
      "match": {
        "lore_first_line_regex": "^An infinite source of (?<block>.+)$",
        "name_regex": "^Infinity (?<block>.+)$",
        "price": "look up the item id in prices.json blocks. slabs, stairs and walls use block_notes"
      }
    },
    "keys": {
      "match": {
        "item": "minecraft:tripwire_hook",
        "lore_regex": "^Opens midas chest",
        "name_regex": "^(?:(?<key>.+?) )?(?:Midas Key|Key of Midas)$",
        "note": "still need samples of every key to verify dataset"
      }
    },
    "glamour": {
      "match": [
        {
          "item": "minecraft:cookie",
          "lore_regex": "grants the (?<aura>.+) aura when eaten",
          "lore_flags": [
            "i"
          ],
          "what": "aura cookie"
        },
        {
          "lore_contains": "Drag and drop on your head",
          "note": "rank line before, month after",
          "what": "hat"
        }
      ]
    },
    "currency": {
      "items": [
        {
          "item": "minecraft:dragon_egg",
          "name": "Degg",
          "vanilla": true,
          "note": "every dragon egg",
          "use": "The main currency of Minewind."
        },
        {
          "item": "minecraft:fire_charge",
          "name": "Ember",
          "lore": "Fossilized dragon fire",
          "use": "Four embers trade for one dragon egg at the Ember Exchange."
        },
        {
          "item": "minecraft:nether_star",
          "name": "Nether Star",
          "vanilla": true,
          "use": "Buys spawn eggs from Lebenskaufmann."
        },
        {
          "item": "minecraft:sunflower",
          "name": "Minewind Gold Coin",
          "enchant": "minecraft:sharpness",
          "use": "27 coins and a raw beef trade for one dragon egg at Buggzzz."
        },
        {
          "item": "minecraft:glowstone_dust",
          "name": "Ancient Gold Powder",
          "enchant": "minecraft:luck_of_the_sea",
          "use": "Buys Level UP Potions and other goods from the Powder Enthusiast."
        },
        {
          "item": "minecraft:iron_nugget",
          "name": "Star Remnant",
          "lore": "An unidentified metal fragment.",
          "use": "Two remnants trade for one nether star at Vaulto."
        },
        {
          "item": "minecraft:amethyst_shard",
          "name": "Shard of Midas",
          "enchant": "minecraft:luck_of_the_sea",
          "use": "Traded with Shardi."
        }
      ]
    },
    "rarity": {
      "items": [
        {
          "item": "minecraft:heart_of_the_sea",
          "name": "Heart of the Sea",
          "vanilla": true
        },
        {
