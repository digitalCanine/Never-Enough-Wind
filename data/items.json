{
  "schema_version": 1,
  "notes": [
    "match on id, custom name and lore, not translated names",
    "1.20.4 nbt is in minecraft:custom_data on 1.21",
    "enchant lines are fake lore"
  ],
  "types": {
    "essence": {
      "match": {
        "item": "minecraft:knowledge_book",
        "name_regex": "^Essence of (?<essence>.+)$",
        "lore_kind_regex": "the essence of an? (?<kind>\\w+)\\.",
        "level": "4th lore line, name + roman level",
        "note": "read the lore, books can be renamed"
      }
    },
    "magic": {
      "match": {
        "item": "minecraft:book",
        "lore_regex": "^- Consumes (?<count>\\d+) (?<soul>\\w+) souls?\\.?$",
        "lore_flags": [
          "i"
        ],
        "fallback_name_regex": "Spellbook$",
        "note": "not all have soul lines or end in Spellbook"
      }
    },
    "infinite": {
      "match": {
        "lore_first_line_regex": "^An infinite source of (?<block>.+)$",
        "name_regex": "^Infinity (?<block>.+)$",
        "price": "look up the item id in prices.json blocks. slabs, stairs and walls use block_notes"
      }
    },
    "keys": {
      "match": {
        "item": "minecraft:tripwire_hook",
        "lore_regex": "^Opens midas chest",
        "name_regex": "^(?:(?<key>.+?) )?(?:Midas Key|Key of Midas)$",
        "note": "only midas keys dumped so far"
      }
    },
    "glamour": {
      "match": [
        {
          "item": "minecraft:cookie",
          "lore_regex": "grants the (?<aura>.+) aura when eaten",
          "lore_flags": [
            "i"
          ],
          "what": "aura cookie"
        },
        {
          "lore_contains": "Drag and drop on your head",
          "note": "rank line before, month after",
          "what": "hat"
        }
      ]
    },
    "currency": {
      "note": "used by spawn traders",
      "items": [
        {
          "item": "minecraft:dragon_egg",
          "name": "Degg",
          "vanilla": true,
          "note": "every dragon egg"
        },
        {
          "item": "minecraft:fire_charge",
          "name": "Ember",
          "lore": "Fossilized dragon fire",
          "note": "0.25 degg"
        },
        {
          "item": "minecraft:nether_star",
          "name": "Nether Star",
          "vanilla": true
        },
        {
          "item": "minecraft:sunflower",
          "name": "Minewind Gold Coin"
        },
        {
          "item": "minecraft:glowstone_dust",
          "name": "Ancient Gold Powder"
        },
        {
          "item": "minecraft:iron_nugget",
          "name": "Star Remnant",
          "lore": "An unidentified metal fragment."
        },
        {
          "item": "minecraft:amethyst_shard",
          "name": "Shard of Midas"
        }
      ]
    },
    "rarity": {
      "items": [
        {
          "item": "minecraft:heart_of_the_sea",
          "name": "Heart of the Sea",
          "vanilla": true
        },
        {
          "item": "minecraft:prismarine_shard",
          "name": "Moonlight Shard",
          "lore": "Lucent triangular crystal"
        },
        {
          "item": "minecraft:ghast_tear",
          "name": "Freyas Tear",
          "lore": "A clear and transparent gem"
        },
        {
          "item": "minecraft:cod",
          "name": "Evolved Blue Fish",
          "lore": "Smells just like regular fish"
        },
        {
          "item": "minecraft:cocoa_beans",
          "name": "Forbidden Cacao Beans",
          "lore": "When it comes to chocolate,"
        },
        {
          "item": "minecraft:gray_dye",
          "name": "Decomposed Dragon Head",
          "lore": "Whoever thought keeping"
        },
        {
          "item": "minecraft:quartz",
          "name": "Union of Conquest",
          "lore": "A symbol of solidarity"
        },
        {
          "item": "minecraft:string",
          "name": "String of Sacrifice",
          "lore": "Its holder will lose nothing"
        },
        {
          "item": "minecraft:bone",
          "name": "Enderbone",
          "lore": "A bone taken from an Enderman"
        },
        {
          "item": "minecraft:spider_eye",
          "name": "Spider Eye of Resetting",
          "lore": "Removes all policies."
        },
        {
          "item": "minecraft:pumpkin_seeds",
          "name": "Victory Beans",
          "lore": "These precious beans"
        },
        {
          "item": "minecraft:cake",
          "name": "Cuik",
          "lore": "Unlike regular Cace, this"
        }
      ]
    },
    "mechanics": {
      "items": [
        {
          "item": "minecraft:compass",
          "name": "Game Menu (Right Click)"
        },
        {
          "item": "minecraft:clock",
          "name": "Land Claim Clock"
        },
        {
          "item": "minecraft:ender_eye",
          "name": "Aura Stone",
          "note": "soulbound"
        },
        {
          "item": "minecraft:stick",
          "name": "Trade Stick",
          "lore": "Trade I"
        }
      ]
    }
  },
  "gear": {
    "essences": {
      "header_line": "Essence",
      "essence_line_regex": "^(?<essence>[A-Za-z' -]+?)( (?<level>[IVX]+))?$",
      "trigger_line_regex": "^  --> (?<triggers>.+)$",
      "effect_line_regex": "^  <-- (?<effects>.+)$",
      "note": "'-' ends the list. normalize names, hyphens differ"
    },
    "souls": {
      "accumulates_regex": "^- Accumulates (?<count>\\d+) (?<soul>\\w+) Souls?\\.?$",
      "consumes_regex": "^- Consumes (?<count>\\d+) (?<soul>\\w+) Souls?\\.?$",
      "lore_flags": [
        "i"
      ]
    },
    "soulbound": {
      "lore_regex": "^Soulbound: (?<name>\\S+)",
      "note": "plain text name, not uuid. aura stone colors are the § bits after it"
    }
  },
  "unknown_yet": [
    "how to tell jester gear from auc gear once a player adds essences to auc gear (maybe inherent essences look different)",
    "non midas keys",
    "communist potato and other castle stuff"
  ]
}
