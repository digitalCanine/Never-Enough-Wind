{
  "schema_version": 1,
  "matching": {
    "input": "getString(), § codes removed, trimmed",
    "regex": "java, group names letters and digits only",
    "flag_i": "case insensitive",
    "order": "category_order"
  },
  "category_order": [
    "dm_received",
    "dm_sent",
    "clan_chat",
    "server_muted",
    "event_countdown",
    "event_starting",
    "event_start",
    "event_placement",
    "event_result",
    "event_end",
    "castle_result",
    "party",
    "spawn_government",
    "death",
    "welcome",
    "vote",
    "sharpen",
    "system",
    "public_action",
    "public_chat"
  ],
  "statuses": {
    "unverified": "not seen yet",
    "confirmed": "seen in a log",
    "wrong": "seen, differs"
  },
  "patterns": [
    {"id": "dm_received", "category": "dm_received", "regex": "^(?<name>[A-Za-z0-9_.]+) >> (?<body>.+)$", "status": "unverified", "note": "name can have a clan prefix"},
    {"id": "dm_sent", "category": "dm_sent", "regex": "^>> (?<name>[A-Za-z0-9_.]+): (?<body>.+)$", "status": "unverified"},
    {"id": "clan_chat", "category": "clan_chat", "regex": "^\\[(?<clan>\\w+)\\] (?<name>\\S+): (?<body>.+)$", "status": "confirmed"},
    {"id": "server_muted", "category": "server_muted", "regex": "^❤", "status": "unverified", "note": "server muted player"},
    {"id": "countdown_generic", "category": "event_countdown", "regex": "^(?<event>.+?) begins in (?<time>1 hour|\\d+ hours?|\\d+ minutes?|\\d+ seconds?)\\.", "flags": ["i"], "status": "unverified"},
    {"id": "countdown_snovasion", "category": "event_countdown", "event": "snovasion", "regex": "^Snovasion Event begins in (?<time>1 hour|\\d+ minutes?|\\d+ seconds?)\\.", "status": "unverified"},
    {"id": "countdown_labyrinth", "category": "event_countdown", "event": "labyrinth", "regex": "^Labyrinth Event begins in (?<time>1 hour|\\d+ minutes?|\\d+ seconds?)\\.$", "flags": ["i"], "status": "unverified"},
    {"id": "countdown_beef", "category": "event_countdown", "event": "beef", "regex": "^Beef Event begins in (?<time>1 hour|\\d+ minutes?|\\d+ seconds?)\\.$", "flags": ["i"], "status": "unverified"},
    {"id": "countdown_abyssal", "category": "event_countdown", "event": "abyssal", "regex": "^Abyssal event begins in (?<time>1 hour|\\d+ minutes?|\\d+ seconds?)\\.$", "status": "unverified"},
    {"id": "countdown_attack_on_giant", "category": "event_countdown", "event": "attack_on_giant", "regex": "^Attack on Giant Event begins in (?<time>1 hour|\\d+ minutes?|\\d+ seconds?)\\.$", "flags": ["i"], "status": "unverified"},
    {"id": "countdown_fox_hunt", "category": "event_countdown", "event": "fox_hunt", "regex": "^Fox Hunt Event begins in (?<time>1 hour|\\d+ minutes?|\\d+ seconds?)\\.$", "flags": ["i"], "status": "unverified"},
    {"id": "countdown_bait", "category": "event_countdown", "event": "bait", "regex": "^Bait Event begins in (?<time>1 hour|\\d+ minutes?|\\d+ seconds?)\\.$", "flags": ["i"], "status": "confirmed"},
    {"id": "countdown_free_for_all", "category": "event_countdown", "event": "free_for_all", "regex": "^Free-For-All Event begins in (?<time>1 hour|\\d+ minutes?|\\d+ seconds?)\\.$", "flags": ["i"], "status": "unverified"},
    {"id": "countdown_team_deathmatch", "category": "event_countdown", "event": "team_deathmatch", "regex": "^Team Deathmatch Event begins in (?<time>1 hour|\\d+ minutes?|\\d+ seconds?)\\.$", "flags": ["i"], "status": "unverified"},
    {"id": "countdown_castle", "category": "event_countdown", "event": "castle", "regex": "^Battle for Minewind begins in (?<time>1 hour|\\d+ minutes?|\\d+ seconds?)\\.", "flags": ["i"], "status": "unverified", "note": "can have a second line"},
    {"id": "castle_link", "category": "event_countdown", "event": "castle", "regex": "minewind\\.com/battle", "flags": ["i"], "status": "unverified", "note": "second line of castle countdown"},
    {"id": "starting_labyrinth", "category": "event_starting", "event": "labyrinth", "regex": "^Labyrinth event is starting\\.\\.\\.$", "flags": ["i"], "status": "unverified"},
    {"id": "start_snovasion", "category": "event_start", "event": "snovasion", "regex": "^Snowmen invade /pvp!", "status": "unverified"},
    {"id": "start_labyrinth", "category": "event_start", "event": "labyrinth", "regex": "^Labyrinth event has started!$", "flags": ["i"], "status": "unverified"},
    {"id": "start_beef", "category": "event_start", "event": "beef", "regex": "^Beef has started!$", "flags": ["i"], "status": "unverified"},
    {"id": "start_abyssal", "category": "event_start", "event": "abyssal", "regex": "^Abyssal event has started!$", "status": "unverified"},
    {"id": "start_attack_on_giant", "category": "event_start", "event": "attack_on_giant", "regex": "^Attack on Giant Event has begun!$", "flags": ["i"], "status": "unverified"},
    {"id": "start_fox_hunt", "category": "event_start", "event": "fox_hunt", "regex": "^Fox Hunt has begun!$", "flags": ["i"], "status": "unverified"},
    {"id": "start_bait", "category": "event_start", "event": "bait", "regex": "^Bait Event has started!$", "flags": ["i"], "status": "unverified", "note": "not sent for bait, sidebar shows up instead"},
    {"id": "start_castle", "category": "event_start", "event": "castle", "regex": "^Battle for Minewind (?:has started|has begun)!?\\.?$", "flags": ["i"], "status": "unverified"},
    {"id": "placement_fox_hunt", "category": "event_placement", "event": "fox_hunt", "regex": "^(?<place>[123])\\) (?<name>[A-Za-z0-9_]{2,16}) -- (?<score>\\d+) foxes$", "flags": ["i"], "status": "unverified"},
    {"id": "placement_bait", "category": "event_placement", "event": "bait", "regex": "^(?<place>[123])\\) (?<name>[A-Za-z0-9_]{2,16}) -- (?<score>\\d+) fish$", "flags": ["i"], "status": "confirmed"},
    {"id": "placement_free_for_all", "category": "event_placement", "event": "free_for_all", "regex": "^(?<place>[123])\\) (?<name>[A-Za-z0-9_]{2,16}) -- (?<score>\\d+) kills$", "status": "unverified"},
    {"id": "result_beef", "category": "event_result", "event": "beef", "regex": "^Team (?<team>aqua|red) wins the beef event!$", "flags": ["i"], "status": "unverified", "note": "ends beef"},
    {"id": "result_abyssal", "category": "event_result", "event": "abyssal", "regex": "^(?<name>[A-Za-z0-9_]{2,16}) wins the abyssal event! Poseidon is pleased!$", "flags": ["i"], "status": "unverified", "note": "ends abyssal"},
    {"id": "result_team_deathmatch", "category": "event_result", "event": "team_deathmatch", "regex": "^Team (?<team>aqua|red) wins the Team Deathmatch event!$", "status": "unverified", "note": "ends tdm"},
    {"id": "end_snovasion", "category": "event_end", "event": "snovasion", "regex": "^Snowmen melt away!$", "status": "unverified"},
    {"id": "end_labyrinth", "category": "event_end", "event": "labyrinth", "regex": "^Labyrinth event has ended!$", "flags": ["i"], "status": "unverified"},
    {"id": "end_attack_on_giant", "category": "event_end", "event": "attack_on_giant", "regex": "^Attack on Giant Event ends!$", "flags": ["i"], "status": "unverified"},
    {"id": "end_fox_hunt", "category": "event_end", "event": "fox_hunt", "regex": "^Fox Hunt event ends!$", "flags": ["i"], "status": "unverified"},
    {"id": "end_bait", "category": "event_end", "event": "bait", "regex": "^Fishing event ends!$", "flags": ["i"], "status": "confirmed"},
    {"id": "end_free_for_all", "category": "event_end", "event": "free_for_all", "regex": "^Free-For-All event ends!$", "flags": ["i"], "status": "unverified"},
    {"id": "castle_hold", "category": "castle_result", "event": "castle", "regex": "^(?<clanName>[A-Za-z0-9 ]{1,64}) \\((?<clan>[A-Za-z0-9]{1,4})\\) hold the Minewind City!$", "flags": ["i"], "status": "unverified", "note": "ends castle"},
    {"id": "castle_take", "category": "castle_result", "event": "castle", "regex": "^(?<clanName>[A-Za-z0-9 ]{1,64}) \\((?<clan>[A-Za-z0-9]{1,4})\\) take the Minewind City from (?<oldClanName>[A-Za-z0-9 ]{1,64}) \\((?<oldClan>[A-Za-z0-9]{1,4})\\)!", "flags": ["i"], "status": "unverified", "note": "ends castle"},
    {"id": "government_lifted", "category": "spawn_government", "regex": "(?<form>Fascism|Communism|Capitalism|Anarchy).+has been lifted", "status": "unverified"},
    {"id": "party_join", "category": "party", "regex": "^(?<name>[A-Za-z0-9_]{2,16}) joined party! Max loot multiplier is now (?<multiplier>\\d+)%\\.$", "status": "confirmed"},
    {"id": "party_leave", "category": "party", "regex": "^(?<name>[A-Za-z0-9_]{2,16}) left party\\. Max loot multiplier is now (?<multiplier>\\d+)%\\.$", "status": "confirmed", "note": "not sent to the one leaving"},
    {"id": "welcome", "category": "welcome", "regex": "^Welcome (?<name>[A-Za-z0-9_]{2,16})!$", "status": "confirmed", "note": "sent twice sometimes"},
    {"id": "vote", "category": "vote", "regex": "^/vote -> (?<name>[A-Za-z0-9_]{2,16}): (?<body>.*)$", "status": "unverified"},
    {"id": "sharpen", "category": "sharpen", "regex": "^(?<name>[A-Za-z0-9_]{2,16}) sharpened (?<item>.*) to \\+(?<level>\\d+)!$", "status": "unverified"},
    {"id": "system_chatlevel", "category": "system", "regex": "^Your /chatlevel is \\w+$", "status": "unverified"},
    {"id": "system_mail", "category": "system", "regex": "^You have (?:\\d+ )?new mail\\. Try /claim$", "status": "unverified"},
    {"id": "system_rewards", "category": "system", "regex": "^You have \\d+ rewards? to /claim$", "status": "unverified"},
    {"id": "system_claimed_mail", "category": "system", "regex": "^Claimed mail:", "flags": ["i"], "status": "unverified"},
    {"id": "system_news", "category": "system", "regex": "^Visit Minewind\\.com for News and Information$", "status": "unverified"},
    {"id": "system_feedback", "category": "system", "regex": "^Have an idea to better the server\\? Minewind\\.com/feedback$", "status": "unverified"},
    {"id": "system_bugs", "category": "system", "regex": "^Report bugs at Minewind\\.com/bugs$", "status": "unverified"},
    {"id": "system_unknown_command", "category": "system", "regex": "^Unknown command\\. Type \"/help\" for help\\.$", "status": "unverified"},
    {"id": "system_nick_taken", "category": "system", "regex": "^Nick is already taken$", "status": "unverified", "note": "chat name isnt always the username"},
    {"id": "system_accept_tp", "category": "system", "regex": "acceptTP", "status": "unverified"},
    {"id": "system_own_arrow", "category": "system", "regex": "^(?<name>\\S+) <- ", "status": "unverified", "note": "reward receipt"},
    {"id": "public_action", "category": "public_action", "regex": "^\\* (?<name>[A-Za-z0-9_ ❤]{1,16}) (?<body>.*)$", "status": "unverified"},
    {"id": "public_chat", "category": "public_chat", "regex": "^(?:☘ )?(?:(?<clan>[A-Za-z0-9]{1,4})\\.)?(?<name>[A-Za-z0-9❤_ ]{1,16}): (?<body>.*)$", "status": "confirmed", "note": "clan tag before the dot, name can be a nick"}
  ],
  "death_patterns": {
    "status": "unverified",
    "note": "killer and victim not split yet",
    "regexes": [
      "^[A-Za-z0-9_]{2,16} is on RAMPAGE!+$",
      "^[A-Za-z0-9_]{2,16} died$",
      "^[A-Za-z0-9_]{2,16} starved to death( while fighting .*)?$",
      "^[A-Za-z0-9_]{2,16} drowned( while trying to escape .*)?$",
      "^[A-Za-z0-9_]{2,16} blew up$",
      "^[A-Za-z0-9_]{2,16} self-disintegrated$",
      "^[A-Za-z0-9_]{2,16} was pricked to death$",
      "^[A-Za-z0-9_]{2,16} died to the void \\(Death #\\d+\\)$",
      "^[A-Za-z0-9_]{2,16} went up in flames$",
      "^[A-Za-z0-9_]{2,16} fell off a ladder$",
      "^[A-Za-z0-9_]{2,16} burned to death$",
      "^[A-Za-z0-9_]{2,16} went off with a bang( due to a firework fired from .*)?$",
      "^[A-Za-z0-9_]{2,16} froze to death$",
      "^[A-Za-z0-9_]{2,16} lost \\d+ fish as they teleported away$",
      "^[A-Za-z0-9_]{2,16} lost \\d+ fish$",
      "^[A-Za-z0-9_]{2,16} was frozen to death by .*$",
      "^[A-Za-z0-9_]{2,16} pwned [A-Za-z0-9_]{2,16} for \\d+!$",
      "^[A-Za-z0-9_]{2,16} rekt [A-Za-z0-9_]{2,16} for \\d+ fish$",
      "^[A-Za-z0-9_]{2,16} got \\d+ (fish|kills) from [A-Za-z0-9_]{2,16} as they ran away$",
      "^[A-Za-z0-9_]{2,16} lost \\d+ (fish|kills) as they ran away$",
      "^[A-Za-z0-9_]{2,16} was stung to death$",
      "^[A-Za-z0-9_]{2,16} was obliterated by a sonically-charged shriek$",
      "^[A-Za-z0-9_]{2,16} was poked to death by a sweet berry bush( while trying to escape .*)?$",
      "^[A-Za-z0-9_]{2,16} was struck by lightning( while fighting .*)?$",
      "^[A-Za-z0-9_]{2,16} committed blood sacrifice$",
      "^[A-Za-z0-9_]{2,16} discovered the floor was lava$",
      "^[A-Za-z0-9_]{2,16} didn't want to live in the same world as .*$",
      "^[A-Za-z0-9_]{2,16} tried to swim in lava( to escape .*)?$",
      "^[A-Za-z0-9_]{2,16} withered away( while fighting .*)?$",
      "^[A-Za-z0-9_]{2,16} suffocated in a wall( while fighting .*)?$",
      "^[A-Za-z0-9_]{2,16} fell out of the world$",
      "^[A-Za-z0-9_]{2,16} fell off some vines$",
      "^[A-Za-z0-9_]{2,16} hit the ground too hard( while trying to escape .*)?$",
      "^[A-Za-z0-9_]{2,16} was killed by magic$",
      "^[A-Za-z0-9_]{2,16} was killed by .* while trying to hurt [A-Za-z0-9_]{2,16}$",
      "^[A-Za-z0-9_]{2,16} was doomed to fall( by .*)?$",
      "^[A-Za-z0-9_]{2,16} was doomed to fall( because of .*)?$",
      "^[A-Za-z0-9_]{2,16} fell from a high place$",
      "(?i)^[A-Za-z0-9_]{2,16} rekt [A-Za-z0-9_]{2,16} (using .*)?(for \\d+ (kills))?(and got an? (double|TRIPLE|ULTRA) kill!)?$",
      "^[A-Za-z0-9_]{2,16} was (killed|rekt|slain|shot|cursed|blown up|fireballed|fragged|zapped|zeused|lavaed|spirited away|Dragon Pounced|grug stomped|sparked|batted) by [A-Za-z0-9_' ]{2,32}.*?$",
      "^[A-Za-z0-9_]{2,16} was impaled by [A-Za-z0-9_' ]{2,32}( with .*)?$",
      "^[A-Za-z0-9_]{2,16} was rekt by [A-Za-z0-9_]{2,16}'s (Elder Branch|Master Blaze) using .*$",
      "^[A-Za-z0-9_]{2,16} experienced kinetic energy( while trying to escape .*)?$",
      "^[A-Za-z0-9_]{2,16} died because of [A-Za-z0-9_]{2,16}('s .*)?$",
      "^[A-Za-z0-9_]{2,16} sucked [A-Za-z0-9_]{2,16} dry$",
      "^[A-Za-z0-9_]{2,16} borrowed soul of [A-Za-z0-9_]{2,16}$",
      "^[A-Za-z0-9_]{2,16} beefed [A-Za-z0-9_]{2,16} for \\d+!$",
      "^[A-Za-z0-9_]{2,16} walked into the danger zone due to [A-Za-z0-9_]{2,16}$",
      "^[A-Za-z0-9_]{2,16} was burned to a crisp while fighting .*$",
      "^[A-Za-z0-9_]{2,16} was killed by magic while trying to escape [A-Za-z0-9_]{2,16}$",
      "^[A-Za-z0-9_]{2,16} was (forked|chickened|blown up) by [A-Za-z0-9_]{2,16}$",
      "^[A-Za-z0-9_]{2,16} walked into fire while fighting (.*)?$"
    ]
  },
  "unknown_yet": [
    "boss daily line (something like 'daily blood spilled')",
    "line announcing a new spawn government, and the Anarchy wording",
    "/clan find <tag> reply format"
  ]
}
